# ─────────────────────────────────────────────────────────────────────────────
# VibePilot backend — environment variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
DEBUG=false

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Example for local Next.js dev: http://localhost:3000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ── Google Gemini LLM ─────────────────────────────────────────────────────────
# Get your free key at: https://aistudio.google.com/apikey
# Without this key the API returns a clearly-labelled DEMO response.
GEMINI_API_KEY=replace_with_your_gemini_api_key
GEMINI_MODEL=gemini-2.0-flash

# ── Future: TinyFish browser agent ────────────────────────────────────────────
TINYFISH_API_KEY=replace_with_your_tinyfish_api_key

# ── Future: Database ──────────────────────────────────────────────────────────
# SQLite (default for dev):
DATABASE_URL=sqlite:///./vibepilot.db
# PostgreSQL example (production):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/vibepilot
